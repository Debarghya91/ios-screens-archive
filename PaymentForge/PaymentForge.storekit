{"_readme":"PaymentForge StoreKit Configuration for local testing in Xcode. This file lets the app fetch and buy the 12 course products WITHOUT a paid Developer Program account and WITHOUT App Store Connect. HOW TO USE: in Xcode, go to Product > Scheme > Edit Scheme > Run > Options > StoreKit Configuration, and select PaymentForge.storekit. Then Run the app and buy in the sandbox (no real money is charged; use a sandbox Apple ID, or the local StoreKit test account Xcode offers). WHAT THE OWNER MUST DO LATER: once he enrols in the paid Apple Developer Program ($99/year), create the real products in App Store Connect with the SAME product IDs below, each type Non-Consumable, at the SAME INR prices. The app code does not change; StoreKit will then fetch the real products from the App Store instead of this file. Do NOT change the product IDs, they must match in both places. Products: com.paymentforge.app.full (Rs. 9,999), com.paymentforge.app.foundations (Rs. 1,499), com.paymentforge.app.messaging (Rs. 2,999), com.paymentforge.app.rails (Rs. 2,499), com.paymentforge.app.crossborder (Rs. 1,999), com.paymentforge.app.clearing (Rs. 999), com.paymentforge.app.cards (Rs. 1,499), com.paymentforge.app.compliance-ops (Rs. 1,999), com.paymentforge.app.architecture-apis (Rs. 2,499), com.paymentforge.app.ba-practice (Rs. 1,999), com.paymentforge.app.emerging (Rs. 999), com.paymentforge.app.situations (Rs. 4,999).","identifier":"PaymentForge","products":[{"displayPrice":"9999.00","familyShareable":true,"internalID":"paymentforge-full-001","productID":"com.paymentforge.app.full","referenceName":"The Integrated Course","type":"Non-Consumable"},{"displayPrice":"1499.00","familyShareable":true,"internalID":"paymentforge-foundations-001","productID":"com.paymentforge.app.foundations","referenceName":"Payment Foundations","type":"Non-Consumable"},{"displayPrice":"2999.00","familyShareable":true,"internalID":"paymentforge-messaging-001","productID":"com.paymentforge.app.messaging","referenceName":"ISO 20022 and SWIFT Messaging","type":"Non-Consumable"},{"displayPrice":"2499.00","familyShareable":true,"internalID":"paymentforge-rails-001","productID":"com.paymentforge.app.rails","referenceName":"Global Payment Rails","type":"Non-Consumable"},{"displayPrice":"1999.00","familyShareable":true,"internalID":"paymentforge-crossborder-001","productID":"com.paymentforge.app.crossborder","referenceName":"Cross-Border and Correspondent Banking","type":"Non-Consumable"},{"displayPrice":"999.00","familyShareable":true,"internalID":"paymentforge-clearing-001","productID":"com.paymentforge.app.clearing","referenceName":"Clearing, Settlement and Liquidity","type":"Non-Consumable"},{"displayPrice":"1499.00","familyShareable":true,"internalID":"paymentforge-cards-001","productID":"com.paymentforge.app.cards","referenceName":"Cards and Domestic Payments","type":"Non-Consumable"},{"displayPrice":"1999.00","familyShareable":true,"internalID":"paymentforge-compliance-ops-001","productID":"com.paymentforge.app.compliance-ops","referenceName":"Compliance, Risk, Operations and Reconciliation","type":"Non-Consumable"},{"displayPrice":"2499.00","familyShareable":true,"internalID":"paymentforge-architecture-apis-001","productID":"com.paymentforge.app.architecture-apis","referenceName":"Payment Architecture and APIs","type":"Non-Consumable"},{"displayPrice":"1999.00","familyShareable":true,"internalID":"paymentforge-ba-practice-001","productID":"com.paymentforge.app.ba-practice","referenceName":"BA and PO Professional Practice","type":"Non-Consumable"},{"displayPrice":"999.00","familyShareable":true,"internalID":"paymentforge-emerging-001","productID":"com.paymentforge.app.emerging","referenceName":"Emerging Technologies and the Future","type":"Non-Consumable"},{"displayPrice":"4999.00","familyShareable":true,"internalID":"paymentforge-situations-001","productID":"com.paymentforge.app.situations","referenceName":"Payment Situations","type":"Non-Consumable"}],"settings":{"locale":"en_IN"},"version":"1"}